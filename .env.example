# Supabase — new project, not the legacy one.
# Keys are on Project Settings → API Keys. Publishable goes in the browser;
# secret never leaves the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Postgres. Transaction pooler (port 6543) — src/server/db.ts is configured
# for it with prepare: false.
DATABASE_URL=

# Legacy project, read-only. Only scripts/import-from-legacy.ts uses these,
# and only at cutover.
LEGACY_DATABASE_URL=
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SECRET_KEY=
